<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#111827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OKUL ZİLİ"
            android:textColor="#A5B4FC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:40"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="DERS PROGRAMI"
        android:textColor="#A5B4FC"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Program yükleniyor"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Sonraki ders"
        android:textColor="#CBD5E1"
        android:textSize="9sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:padding="5dp"
        android:background="#332B1D"
        android:text="DERS NOTLARI"
        android:textColor="#FDE68A"
        android:textSize="10sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:padding="5dp"
        android:background="#15372F"
        android:text="GÖREVLER"
        android:textColor="#A7F3D0"
        android:textSize="10sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:padding="5dp"
        android:background="#40243A"
        android:text="HATIRLATICILAR"
        android:textColor="#FBCFE8"
        android:textSize="10sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_quick_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:padding="5dp"
        android:background="#20334E"
        android:text="TAKVİM"
        android:textColor="#BFDBFE"
        android:textSize="9sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="9sp"
        android:autoSizeStepGranularity="1sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />
</LinearLayout>