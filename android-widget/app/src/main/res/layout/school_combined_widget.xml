<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/combined_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#101827">

    <TextView
        android:id="@+id/combined_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tarih"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/combined_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="ZİL DURUMU"
        android:textColor="#A5B4FC"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Ders"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Takvim etkinliği"
        android:textColor="#FBBF24"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#334155"
        android:text="" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="HAFTANIN ATASÖZÜ"
        android:textColor="#6EE7B7"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_proverb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Atasözü"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Anlamı"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />
</LinearLayout>
