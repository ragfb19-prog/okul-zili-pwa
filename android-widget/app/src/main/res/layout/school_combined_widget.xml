<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/combined_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#101827">

    <TextView
        android:id="@+id/combined_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tarih • Saat"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/combined_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="ZİL DURUMU"
        android:textColor="#A5B4FC"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Ders"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:padding="8dp"
        android:background="#263449"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Takvim etkinliği"
        android:textColor="#FDE68A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
