<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#142033">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OKUL TAKVİMİ" android:textColor="#9FB9FF" android:textSize="11sp" android:textStyle="bold"/>
<TextView android:id="@+id/calendar_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tarih" android:textColor="#CFD8E8" android:textSize="12sp" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/calendar_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yaklaşan etkinlik" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/calendar_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Etkinlik tarihi" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_marginTop="3dp"/>
<TextView android:id="@+id/calendar_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BU HAFTA" android:textColor="#FBBF24" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
</LinearLayout>