<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Program - Canlı Telefon & Gemini Kumandası</title>
  
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234F46E5' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0.5-5'/><circle cx='13' cy='11' r='4'/><path d='M13 9v2l1.5 1'/></svg>">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .current-active { border-color: #6366f1 !important; box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25); }
    .timer-digits { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- Üst Bar -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-md shadow-indigo-100">
          <i data-lucide="calendar-check" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg sm:text-xl tracking-tight text-slate-900 leading-none">Program</h1>
          <span class="text-[11px] text-slate-500 font-medium">Telefon & Gemini Canlı Kumanda</span>
        </div>
      </div>

      <!-- Aksiyonlar ve Canlı Saat -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden md:flex flex-col text-right">
          <span id="liveClock" class="font-mono text-base font-bold text-slate-700">00:00:00</span>
          <span id="topStatusBadge" class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">Çevrimiçi</span>
        </div>

        <!-- TELEFON BAĞLA BUTONU (QR KOD) -->
        <button onclick="openPhoneConnectModal()" class="flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition active:scale-95">
          <i data-lucide="smartphone" class="w-4 h-4"></i>
          <span>📱 Telefonu Bağla (QR Kod)</span>
        </button>

        <button onclick="toggleSound()" id="soundBtn" title="Zil Sesi Aç/Kapat" class="p-2 text-indigo-600 hover:bg-slate-50 bg-slate-50 border border-slate-200 rounded-xl transition">
          <i data-lucide="volume-2" class="w-4 h-4"></i>
        </button>

        <button onclick="toggleApiKeyModal()" class="flex items-center gap-1 px-3 py-2 text-xs font-semibold rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition">
          <i data-lucide="sparkles" class="w-4 h-4 text-indigo-600"></i>
          <span class="hidden sm:inline">Gemini API</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Ana İçerik -->
  <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Sol/Orta Alan: Canlı Widget + Çizelge -->
    <section class="lg:col-span-2 flex flex-col gap-4">
      
      <!-- CANLI GERİ SAYIM SAYACI WİDGET'I -->
      <div id="liveCountdownWidget" class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-950 via-indigo-900 to-slate-900 text-white p-5 sm:p-6 shadow-xl border border-indigo-800/40">
        <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span id="widgetBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wide uppercase bg-indigo-500/30 text-indigo-200 border border-indigo-400/30 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="widgetBadgeText">Canlı Takip</span>
              </span>
              <span id="widgetTodayText" class="text-xs text-indigo-200/70 font-medium">Bugün</span>
            </div>
            
            <h2 id="widgetCurrentTitle" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
              Yükleniyor...
            </h2>
            
            <p id="widgetNextInfo" class="text-xs sm:text-sm text-indigo-200/80 flex items-center gap-1.5 pt-0.5">
              <i data-lucide="arrow-right-circle" class="w-4 h-4 text-indigo-400"></i>
              <span>Sırada: <strong>Hesaplanıyor</strong></span>
            </p>
          </div>

          <!-- Geri Sayım Sayacı -->
          <div class="w-full sm:w-auto bg-white/10 backdrop-blur-md px-5 py-3.5 rounded-2xl border border-white/10 text-center sm:text-right shrink-0">
            <span id="countdownLabel" class="block text-[11px] font-semibold uppercase tracking-wider text-indigo-200">
              Zilin Çalmasına Kalan
            </span>
            <div id="countdownTimer" class="timer-digits text-3xl sm:text-4xl font-black tracking-tight text-white font-mono mt-0.5">
              00:00:00
            </div>
            <span id="countdownDurationText" class="text-[10px] text-indigo-300">Danişment Çizelgesi</span>
          </div>
        </div>

        <!-- İlerleme Çubuğu -->
        <div class="mt-4 pt-3 border-t border-white/10">
          <div class="flex items-center justify-between text-xs text-indigo-200/80 mb-1.5 font-medium">
            <span id="progressStartLabel">08:40</span>
            <span id="progressPercentLabel">%0 Tamamlandı</span>
            <span id="progressEndLabel">15:15</span>
          </div>
          <div class="w-full h-2.5 bg-black/30 rounded-full overflow-hidden p-0.5">
            <div id="widgetProgressBar" class="h-full bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 rounded-full transition-all duration-700" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- Gün Seçici Barı -->
      <div class="bg-white p-2 rounded-2xl border border-slate-200 flex justify-between gap-1 overflow-x-auto shadow-sm">
        <button onclick="selectDay('Pazartesi')" class="day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm">Pazartesi</button>
        <button onclick="selectDay('Salı')" class="day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition hover:bg-slate-100 text-slate-600">Salı</button>
        <button onclick="selectDay('Çarşamba')" class="day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition hover:bg-slate-100 text-slate-600">Çarşamba</button>
        <button onclick="selectDay('Perşembe')" class="day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition hover:bg-slate-100 text-slate-600">Perşembe</button>
        <button onclick="selectDay('Cuma')" class="day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition hover:bg-slate-100 text-slate-600">Cuma</button>
      </div>

      <!-- Araç Butonları -->
      <div class="flex items-center justify-between text-xs px-1">
        <div class="flex items-center gap-2">
          <button onclick="requestNotificationPermission()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 shadow-sm font-medium">
            <i data-lucide="bell" class="w-3.5 h-3.5 text-indigo-500"></i>
            <span>Zil Bildirimleri</span>
          </button>
          <button onclick="resetToOfficialTemplate()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-500 hover:text-rose-600 shadow-sm font-medium">
            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
            <span>Sıfırla</span>
          </button>
        </div>
        <span class="text-slate-500 font-medium" id="activeDayText">Pazartesi Programı</span>
      </div>

      <!-- Çizelge Listesi -->
      <div id="scheduleContainer" class="flex flex-col gap-2.5">
        <!-- Dinamik dolar -->
      </div>
    </section>

    <!-- Sağ Alan: Canlı Bağlantı ve Hızlı İşlem Durumu -->
    <aside class="flex flex-col gap-4">
      
      <!-- Telefon Durum Kartı -->
      <div class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-3xl p-5 shadow-lg">
        <div class="flex items-center gap-3 pb-3 border-b border-white/20">
          <div class="p-2.5 rounded-2xl bg-white/20 text-white">
            <i data-lucide="radio" class="w-6 h-6 animate-pulse text-emerald-200"></i>
          </div>
          <div>
            <h2 class="font-bold text-sm">Canlı Telefon Köprüsü</h2>
            <p id="bridgeStatusText" class="text-[11px] text-emerald-100">Bağlantı açık, komut dinleniyor</p>
          </div>
        </div>

        <div class="py-3 text-xs space-y-2 text-emerald-50">
          <p class="leading-relaxed">
            Telefonundan QR kodu okutup konuştuğun her şey anında buraya işlenir.
          </p>
          <div class="p-2.5 rounded-xl bg-black/15 font-mono text-[11px] space-y-1">
            <span class="text-emerald-300 font-bold block">Son İşlenen Komut:</span>
            <span id="lastActionDisplay" class="italic text-white">Henüz komut gelmedi.</span>
          </div>
        </div>

        <button onclick="openPhoneConnectModal()" class="w-full py-2 bg-white text-emerald-800 rounded-xl font-bold text-xs hover:bg-emerald-50 transition shadow-sm">
          📱 QR Kodu ve Bağlantıyı Göster
        </button>
      </div>

      <!-- Hızlı Bilgi -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm text-xs space-y-2">
        <h3 class="font-bold text-slate-800 flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-4 h-4 text-indigo-600"></i>
          <span>Gemini Ne Yapabilir?</span>
        </h3>
        <p class="text-slate-500 leading-relaxed">
          Telefonda mikrofona basıp:
        </p>
        <ul class="space-y-1.5 text-slate-600 text-[11px]">
          <li class="bg-slate-50 p-2 rounded-lg border border-slate-100">📌 <em>"Salı 3. dersi Matematik yap"</em></li>
          <li class="bg-slate-50 p-2 rounded-lg border border-slate-100">📝 <em>"Çarşamba 1. derse ödev kontrolü notunu ekle"</em></li>
          <li class="bg-slate-50 p-2 rounded-lg border border-slate-100">🎯 <em>"Cuma 5. dersi İngilizce yap, sınav var diye not koy"</em></li>
        </ul>
      </div>

    </aside>

  </main>

  <!-- Modal: Telefon Bağlantısı ve QR Kod -->
  <div id="phoneConnectModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4 text-center">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
          <i data-lucide="smartphone" class="w-5 h-5 text-emerald-600"></i>
          <span>Telefondan Bağlan</span>
        </h3>
        <button onclick="closePhoneConnectModal()" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <p class="text-xs text-slate-500 leading-relaxed">
        Telefonunun kamerasını aç ve aşağıdaki <strong>QR Kodu okut</strong>. Telefonunda doğrudan sesli kumanda açılacaktır!
      </p>

      <!-- QR Kod Görseli -->
      <div class="flex justify-center py-2">
        <div class="p-3 bg-white border-2 border-dashed border-emerald-400 rounded-2xl shadow-sm">
          <img id="qrCodeImg" src="" alt="Telefon Bağlantı QR Kodu" class="w-44 h-44 rounded-lg">
        </div>
      </div>

      <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
        <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider block">Özel Bağlantı Kodun</span>
        <span id="displayRoomCode" class="text-2xl font-black font-mono text-indigo-600">...</span>
      </div>

      <button onclick="openRemoteHereForTest()" class="text-xs text-indigo-600 hover:underline font-semibold block mx-auto">
        (Veya telefondaki kumandayı bu ekranda dene)
      </button>
    </div>
  </div>

  <!-- Modal: Gemini API Key -->
  <div id="apiKeyModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 space-y-4 text-xs">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-base text-slate-800">Gemini API Anahtarı</h3>
        <button onclick="toggleApiKeyModal()" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <p class="text-slate-500 leading-relaxed">
        Telefonda sesli söylediğin şeyleri Gemini'nin anlayıp programa yazabilmesi için Google AI Studio'dan aldığın ücretsiz API anahtarını buraya gir.
      </p>
      <div>
        <label class="block font-semibold text-slate-600 mb-1">API Key</label>
        <input type="password" id="geminiApiKeyInput" placeholder="AIzaSy..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-mono">
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="saveApiKey()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl">Kaydet</button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- TELEFON KUMANDASI GÖRÜNÜMÜ (TAM EKRAN MOBİL) -->
  <!-- ========================================== -->
  <div id="remoteControlView" class="fixed inset-0 bg-slate-900 z-50 hidden flex flex-col p-6 text-white justify-between">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center text-white">
          <i data-lucide="mic" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="font-bold text-sm">Program Sesli Kumandası</h2>
          <span class="text-[10px] text-emerald-400">● Bilgisayara Bağlı</span>
        </div>
      </div>
      <button onclick="closeRemoteView()" class="p-2 text-slate-400 hover:text-white">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <!-- Ortadaki Büyük Mikrofon Butonu -->
    <div class="flex flex-col items-center justify-center my-auto space-y-6">
      <button onclick="startPhoneVoice()" id="phoneMicBigBtn" class="w-32 h-32 rounded-full bg-gradient-to-tr from-emerald-500 to-indigo-600 flex items-center justify-center shadow-2xl shadow-emerald-500/30 active:scale-90 transition">
        <i data-lucide="mic" class="w-14 h-14 text-white"></i>
      </button>
      <div class="text-center space-y-1">
        <span id="phoneMicStatus" class="text-base font-bold text-white block">Dokun ve Konuş</span>
        <p class="text-xs text-slate-400 max-w-xs">
          Örn: "Salı günü 3. dersi Matematik yap ve ödev kontrolü notunu ekle"
        </p>
      </div>

      <div id="phoneTranscriptBox" class="w-full bg-white/10 p-4 rounded-2xl border border-white/10 text-xs italic text-indigo-200 text-center min-h-[50px] flex items-center justify-center">
        Söyledikleriniz burada görünecek...
      </div>
    </div>

    <div class="text-center text-[11px] text-slate-500 pb-2">
      Gemini yapay zekası sesini anlar ve bilgisayardaki programı otomatik günceller.
    </div>
  </div>

  <!-- JavaScript Kodları -->
  <script>
    const OFFICIAL_TEMPLATE = [
      { id: 1, type: 'ders', title: '1. Ders', start: '08:40', end: '09:20', duration: '40 Dakika', notes: '' },
      { id: 2, type: 'teneffus', title: 'Dinlenme', start: '09:20', end: '09:35', duration: '15 Dakika', notes: '' },
      { id: 3, type: 'ders', title: '2. Ders', start: '09:35', end: '10:15', duration: '40 Dakika', notes: '' },
      { id: 4, type: 'teneffus', title: 'Dinlenme', start: '10:15', end: '10:30', duration: '15 Dakika', notes: '' },
      { id: 5, type: 'ders', title: '3. Ders', start: '10:30', end: '11:10', duration: '40 Dakika', notes: '' },
      { id: 6, type: 'teneffus', title: 'Dinlenme', start: '11:10', end: '11:25', duration: '15 Dakika', notes: '' },
      { id: 7, type: 'ders', title: '4. Ders', start: '11:25', end: '12:05', duration: '40 Dakika', notes: '' },
      { id: 8, type: 'ogle', title: 'Öğle Arası', start: '12:05', end: '12:55', duration: '50 Dakika', notes: 'Öğle yemeği ve dinlenme.' },
      { id: 9, type: 'ders', title: '5. Ders', start: '12:55', end: '13:35', duration: '40 Dakika', notes: '' },
      { id: 10, type: 'teneffus', title: 'Dinlenme', start: '13:35', end: '13:45', duration: '10 Dakika', notes: '' },
      { id: 11, type: 'ders', title: '6. Ders', start: '13:45', end: '14:25', duration: '40 Dakika', notes: '' },
      { id: 12, type: 'teneffus', title: 'Dinlenme', start: '14:25', end: '14:35', duration: '10 Dakika', notes: '' },
      { id: 13, type: 'ders', title: '7. Ders', start: '14:35', end: '15:15', duration: '40 Dakika', notes: 'Günün son dersi.' }
    ];

    function createFreshWeek() {
      return {
        'Pazartesi': JSON.parse(JSON.stringify(OFFICIAL_TEMPLATE)),
        'Salı': JSON.parse(JSON.stringify(OFFICIAL_TEMPLATE)),
        'Çarşamba': JSON.parse(JSON.stringify(OFFICIAL_TEMPLATE)),
        'Perşembe': JSON.parse(JSON.stringify(OFFICIAL_TEMPLATE)),
        'Cuma': JSON.parse(JSON.stringify(OFFICIAL_TEMPLATE))
      };
    }

    const DAYS_TR = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
    const todayIndex = new Date().getDay();
    let currentDay = (todayIndex >= 1 && todayIndex <= 5) ? DAYS_TR[todayIndex] : 'Pazartesi';

    let scheduleData = JSON.parse(localStorage.getItem('danisment_schedule_data')) || createFreshWeek();
    let soundEnabled = true;

    // Özel Oda Kodu (Telefon & Bilgisayar Eşleşmesi İçin)
    let syncRoom = localStorage.getItem('program_room_code');
    if (!syncRoom) {
      syncRoom = 'okul_' + Math.floor(1000 + Math.random() * 9000);
      localStorage.setItem('program_room_code', syncRoom);
    }

    function playSchoolBell() {
      if (!soundEnabled) return;
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const now = audioCtx.currentTime;
        const playTone = (freq, time, dur) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, time);
          gain.gain.setValueAtTime(0.2, time);
          gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(time);
          osc.stop(time + dur);
        };
        playTone(659.25, now, 0.4);
        playTone(523.25, now + 0.35, 0.4);
        playTone(587.33, now + 0.7, 0.4);
        playTone(783.99, now + 1.05, 0.9);
      } catch (e) {}
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      document.getElementById('soundBtn').innerHTML = soundEnabled ? `<i data-lucide="volume-2" class="w-4 h-4 text-indigo-600"></i>` : `<i data-lucide="volume-x" class="w-4 h-4 text-slate-400"></i>`;
      lucide.createIcons();
    }

    // Başlangıç
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      selectDay(currentDay);
      setInterval(updateLiveWidgetAndClock, 1000);
      updateLiveWidgetAndClock();

      // Canlı Bulut Dinleyicisi Başlat (Telefondan gelen sesli komutları yakalar)
      startRealtimeListener();

      // Eğer telefon modunda açıldıysa doğrudan kumandayı aç
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('mode') === 'remote') {
        const remoteRoom = urlParams.get('room');
        if (remoteRoom) syncRoom = remoteRoom;
        document.getElementById('remoteControlView').classList.remove('hidden');
      }
    });

    function selectDay(day) {
      currentDay = day;
      document.querySelectorAll('.day-btn').forEach(btn => {
        btn.className = (btn.innerText === day)
          ? 'day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm'
          : 'day-btn flex-1 py-2 rounded-xl text-xs sm:text-sm font-semibold transition hover:bg-slate-100 text-slate-600';
      });
      document.getElementById('activeDayText').innerText = `${day} Programı`;
      renderSchedule();
      updateLiveWidgetAndClock();
    }

    function saveSchedule() {
      localStorage.setItem('danisment_schedule_data', JSON.stringify(scheduleData));
    }

    function resetToOfficialTemplate() {
      if (confirm('Tüm saatler varsayılana sıfırlansın mı?')) {
        scheduleData = createFreshWeek();
        saveSchedule();
        renderSchedule();
        updateLiveWidgetAndClock();
      }
    }

    function renderSchedule() {
      const container = document.getElementById('scheduleContainer');
      const items = scheduleData[currentDay] || [];
      const now = new Date();
      const currentHM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const isToday = DAYS_TR[now.getDay()] === currentDay;

      container.innerHTML = items.map(item => {
        const isLesson = item.type === 'ders';
        const isLunch = item.type === 'ogle';
        const isActive = isToday && (currentHM >= item.start && currentHM < item.end);

        let badgeBg = isLesson ? 'bg-indigo-50 text-indigo-700 border-indigo-200' : (isLunch ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200');
        let iconName = isLesson ? 'book-open' : (isLunch ? 'utensils' : 'coffee');

        return `
          <div class="bg-white rounded-2xl border ${isActive ? 'border-indigo-600 shadow-md current-active' : 'border-slate-200 shadow-sm'} p-3.5 transition-all">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border ${badgeBg}">
                  <i data-lucide="${iconName}" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-bold text-slate-800 text-sm">${item.title}</h3>
                    ${isActive ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-indigo-600 text-white animate-pulse">ŞU AN</span>' : ''}
                  </div>
                  <div class="flex items-center gap-2 text-xs text-slate-500 font-mono mt-0.5">
                    <span>${item.start} - ${item.end}</span>
                    <span class="text-[10px] font-sans px-1.5 py-0.2 bg-slate-100 rounded text-slate-500">${item.duration || ''}</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-start gap-2">
              <i data-lucide="sticky-note" class="w-3.5 h-3.5 text-slate-400 mt-0.5 shrink-0"></i>
              <p class="text-xs text-slate-600 leading-tight ${!item.notes ? 'italic text-slate-400' : 'font-medium'}">
                ${item.notes || 'Telefonda söylediğiniz notlar buraya gelir.'}
              </p>
            </div>
          </div>
        `;
      }).join('');

      lucide.createIcons();
    }

    function timeToSeconds(timeStr) {
      const [h, m] = timeStr.split(':').map(Number);
      return h * 3600 + m * 60;
    }

    function formatCountdown(sec) {
      if (sec < 0) sec = 0;
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      const mm = String(m).padStart(2, '0');
      const ss = String(s).padStart(2, '0');
      return h > 0 ? `${String(h).padStart(2, '0')}:${mm}:${ss}` : `${mm}:${ss}`;
    }

    function updateLiveWidgetAndClock() {
      const now = new Date();
      document.getElementById('liveClock').innerText = now.toLocaleTimeString('tr-TR');

      const realDayName = DAYS_TR[now.getDay()];
      const isWeekend = (now.getDay() === 0 || now.getDay() === 6);
      const todaySlots = scheduleData[realDayName] || scheduleData['Pazartesi'];

      const nowSec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
      const firstSlot = todaySlots[0];
      const lastSlot = todaySlots[todaySlots.length - 1];

      const firstSlotSec = timeToSeconds(firstSlot.start);
      const lastSlotSec = timeToSeconds(lastSlot.end);

      const titleEl = document.getElementById('widgetCurrentTitle');
      const badgeTextEl = document.getElementById('widgetBadgeText');
      const nextInfoEl = document.getElementById('widgetNextInfo');
      const timerEl = document.getElementById('countdownTimer');
      const timerLabel = document.getElementById('countdownLabel');
      const durationText = document.getElementById('countdownDurationText');
      const pBar = document.getElementById('widgetProgressBar');
      const pLabel = document.getElementById('progressPercentLabel');
      const pStart = document.getElementById('progressStartLabel');
      const pEnd = document.getElementById('progressEndLabel');
      const topBadge = document.getElementById('topStatusBadge');
      const todayBadge = document.getElementById('widgetTodayText');

      todayBadge.innerText = `${realDayName}, ${now.toLocaleDateString('tr-TR')}`;

      if (isWeekend) {
        badgeTextEl.innerText = 'Hafta Sonu';
        titleEl.innerText = 'Hafta Sonu Dinlenmesi 🌟';
        nextInfoEl.innerHTML = `<span>Pazartesi ilk ders: <strong>08:40</strong></span>`;
        timerLabel.innerText = 'Pazartesiye Kalan Süre';
        timerEl.innerText = 'Tatil';
        durationText.innerText = 'İyi tatiller!';
        pBar.style.width = '100%';
        pLabel.innerText = 'Tatilde';
        topBadge.innerText = 'Hafta Sonu';
        return;
      }

      if (nowSec < firstSlotSec) {
        const left = firstSlotSec - nowSec;
        badgeTextEl.innerText = 'Ders Öncesi';
        titleEl.innerText = 'Okul Başlamak Üzere 🎒';
        nextInfoEl.innerHTML = `<span>İlk Ders: <strong>${firstSlot.title} (${firstSlot.start})</strong></span>`;
        timerLabel.innerText = 'İlk Zile Kalan Süre';
        timerEl.innerText = formatCountdown(left);
        durationText.innerText = `İlk ders saat ${firstSlot.start}'ta`;

        pStart.innerText = '00:00';
        pEnd.innerText = firstSlot.start;
        const total = firstSlotSec;
        const pct = Math.min(100, Math.max(0, ((total - left) / total) * 100));
        pBar.style.width = `${pct}%`;
        pLabel.innerText = `%${Math.round(pct)} Yaklaştı`;
        topBadge.innerText = 'İlk Ders Bekleniyor';
        return;
      }

      if (nowSec >= lastSlotSec) {
        badgeTextEl.innerText = 'Okul Çıkışı';
        titleEl.innerText = 'Dersler Bitti! 🎉';
        nextInfoEl.innerHTML = `<span>Günün tüm dersleri tamamlandı.</span>`;
        timerLabel.innerText = 'Günün Durumu';
        timerEl.innerText = 'Bitti';
        durationText.innerText = 'Tebrikler!';
        pBar.style.width = '100%';
        pLabel.innerText = '%100';
        topBadge.innerText = 'Okul Bitti';
        return;
      }

      let currentItem = null;
      let nextItem = null;

      for (let i = 0; i < todaySlots.length; i++) {
        const item = todaySlots[i];
        const sSec = timeToSeconds(item.start);
        const eSec = timeToSeconds(item.end);

        if (nowSec >= sSec && nowSec < eSec) {
          currentItem = item;
          nextItem = todaySlots[i + 1] || null;
          break;
        }
      }

      if (currentItem) {
        const sSec = timeToSeconds(currentItem.start);
        const eSec = timeToSeconds(currentItem.end);
        const leftSec = eSec - nowSec;
        const totalPeriod = eSec - sSec;
        const progress = ((totalPeriod - leftSec) / totalPeriod) * 100;

        const isLesson = currentItem.type === 'ders';
        badgeTextEl.innerText = isLesson ? 'Şu An Ders' : (currentItem.type === 'ogle' ? 'Öğle Arası' : 'Teneffüs');
        titleEl.innerText = `${currentItem.title}`;
        
        timerLabel.innerText = isLesson ? 'Teneffüs Ziline Kalan' : 'Ders Ziline Kalan';
        timerEl.innerText = formatCountdown(leftSec);
        durationText.innerText = `${currentItem.start} - ${currentItem.end}`;

        if (nextItem) {
          nextInfoEl.innerHTML = `<span>Sırada: <strong>${nextItem.title} (${nextItem.start})</strong></span>`;
        } else {
          nextInfoEl.innerHTML = `<span>Sırada: <strong>Okul Çıkışı (15:15)</strong></span>`;
        }

        pStart.innerText = currentItem.start;
        pEnd.innerText = currentItem.end;
        pBar.style.width = `${progress}%`;
        pLabel.innerText = `%${Math.round(progress)} Tamamlandı`;
        topBadge.innerText = `Şu An: ${currentItem.title}`;
      }
    }

    // ==========================================
    // CANLI BULUT KÖPRÜSÜ (NTFY.SH REALTIME)
    // ==========================================
    function startRealtimeListener() {
      try {
        const eventSource = new EventSource(`https://ntfy.sh/${syncRoom}/sse`);
        eventSource.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (data.message) {
              const action = JSON.parse(data.message);
              applyRemoteCommand(action);
            }
          } catch (err) {}
        };
      } catch (e) {
        console.log("Realtime bağlantı bekleniyor");
      }
    }

    function applyRemoteCommand(action) {
      const targetDay = action.day || currentDay;
      const lessonNum = action.lessonNumber || 1;

      if (!scheduleData[targetDay]) return;

      const lessonsOnly = scheduleData[targetDay].filter(s => s.type === 'ders');
      const targetSlot = lessonsOnly[lessonNum - 1];

      if (targetSlot) {
        if (action.newTitle) targetSlot.title = action.newTitle;
        if (action.newNotes) targetSlot.notes = action.newNotes;

        saveSchedule();
        selectDay(targetDay);
        playSchoolBell(); // Bilgisayarda anında zil çalar!

        document.getElementById('lastActionDisplay').innerText = `${targetDay} ${lessonNum}. Ders ➔ ${targetSlot.title} (${targetSlot.notes || 'Not yok'})`;
      }
    }

    // QR Kod ve Telefon Bağlantı Modalı
    function openPhoneConnectModal() {
      document.getElementById('displayRoomCode').innerText = syncRoom;
      
      // Telefonun açacağı canlı kumanda adresi
      const remoteUrl = `${window.location.origin}${window.location.pathname}?mode=remote&room=${syncRoom}`;
      
      // QR kod servisi
      const qrApi = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(remoteUrl)}`;
      document.getElementById('qrCodeImg').src = qrApi;
      
      document.getElementById('phoneConnectModal').classList.remove('hidden');
    }

    function closePhoneConnectModal() {
      document.getElementById('phoneConnectModal').classList.add('hidden');
    }

    function openRemoteHereForTest() {
      closePhoneConnectModal();
      document.getElementById('remoteControlView').classList.remove('hidden');
    }

    function closeRemoteView() {
      document.getElementById('remoteControlView').classList.add('hidden');
    }

    // ==========================================
    // TELEFON SESLİ KUMANDA MOTORU (GEMINI AI)
    // ==========================================
    let phoneRecognition = null;

    function startPhoneVoice() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        alert("Tarayıcınız ses tanımayı desteklemiyor. Lütfen Chrome veya Safari kullanın.");
        return;
      }

      phoneRecognition = new SpeechRecognition();
      phoneRecognition.lang = 'tr-TR';
      phoneRecognition.continuous = false;

      phoneRecognition.onstart = () => {
        document.getElementById('phoneMicStatus').innerText = "🔴 Dinleniyor... Konuşun!";
        document.getElementById('phoneMicBigBtn').classList.add('animate-pulse');
      };

      phoneRecognition.onresult = (event) => {
        const spokenText = event.results[0][0].transcript;
        document.getElementById('phoneTranscriptBox').innerText = `"${spokenText}"`;
        document.getElementById('phoneMicStatus').innerText = "Gemini bilgisayara aktarıyor...";
        sendVoiceCommandToGemini(spokenText);
      };

      phoneRecognition.onerror = () => {
        document.getElementById('phoneMicStatus').innerText = "Tekrar Deneyin";
        document.getElementById('phoneMicBigBtn').classList.remove('animate-pulse');
      };

      phoneRecognition.onend = () => {
        document.getElementById('phoneMicBigBtn').classList.remove('animate-pulse');
      };

      phoneRecognition.start();
    }

    async function sendVoiceCommandToGemini(userText) {
      const apiKey = localStorage.getItem('program_gemini_api_key');
      if (!apiKey) {
        alert("Lütfen önce bilgisayar ekranından 'Gemini API' butonuna basıp anahtarınızı kaydedin.");
        return;
      }

      const prompt = `
Sen akıllı okul programı yöneticisisin. Kullanıcının Türkçe sesli komutunu analiz et ve SADECE aşağıdaki JSON formatında cevap ver:
{
  "day": "Salı", // "Pazartesi", "Salı", "Çarşamba", "Perşembe" veya "Cuma"
  "lessonNumber": 3, // 1'den 7'ye kadar ders sayısı
  "newTitle": "Matematik", // Ders adı
  "newNotes": "Ödev teslimi" // Not veya hatırlatıcı
}
Kullanıcı Sesli Komutu: "${userText}"
`;

      try {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });

        const data = await res.json();
        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text;
        const jsonMatch = reply.match(/\{[\s\S]*\}/);

        if (jsonMatch) {
          const actionJson = jsonMatch[0];
          
          // Buluta fırlat -> Bilgisayar anında yakalar!
          await fetch(`https://ntfy.sh/${syncRoom}`, {
            method: 'POST',
            body: actionJson
          });

          document.getElementById('phoneMicStatus').innerText = "✅ Bilgisayara Eklendi!";
        }
      } catch (err) {
        document.getElementById('phoneMicStatus').innerText = "Hata oluştu, tekrar deneyin.";
      }
    }

    function toggleApiKeyModal() {
      document.getElementById('apiKeyModal').classList.toggle('hidden');
      document.getElementById('geminiApiKeyInput').value = localStorage.getItem('program_gemini_api_key') || '';
    }

    function saveApiKey() {
      const key = document.getElementById('geminiApiKeyInput').value.trim();
      localStorage.setItem('program_gemini_api_key', key);
      toggleApiKeyModal();
      alert('Gemini anahtarı kaydedildi!');
    }

    function requestNotificationPermission() {
      if ('Notification' in window) {
        Notification.requestPermission().then(p => {
          if (p === 'granted') alert('Zil bildirimleri açıldı!');
        });
      }
    }
  </script>
